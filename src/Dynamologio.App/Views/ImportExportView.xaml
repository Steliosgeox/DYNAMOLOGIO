<UserControl x:Class="Dynamologio.App.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Οδηγός Εισαγωγής Προσωπικού από Excel" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
            <TextBlock Text="Ανάλυση, αντιστοίχιση βαθμών/λόχων, έλεγχος διπλοεγγραφών και ασφαλής συναλλαγή εισαγωγής" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- File Selection & Stepper Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardContainer}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Επιλεγμένο Αρχείο Excel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SelectedFilePath}" IsReadOnly="True" />
                </StackPanel>

                <Button Grid.Column="1" Content="Αναζήτηση Αρχείου..." Command="{Binding BrowseFileCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="32" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Εκτέλεση Εισαγωγής" Command="{Binding CommitImportCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="32" />
            </Grid>
        </Border>

        <!-- Preview Table & Status -->
        <Border Grid.Row="2" Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Summary Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Επιλέξτε αρχείο Excel για προεπισκόπηση.'}" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding PreviewReport, Converter={StaticResource NullToVisConverter}}">
                        <Border Background="{StaticResource AccentSubduedBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PreviewReport.NewCount, StringFormat='Νέες: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PreviewReport.UpdateCount, StringFormat='Ενημερώσεις: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                        </Border>
                        <Border Background="#FEE2E2" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding PreviewReport.ErrorCount, StringFormat='Σφάλματα: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- DataGrid Preview -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Γραμμή" Binding="{Binding RowIndex}" Width="60" />
                        <DataGridTextColumn Header="Ενέργεια" Binding="{Binding DisplayActionText}" Width="120" />
                        <DataGridTextColumn Header="ΑΣΜ" Binding="{Binding MilitaryServiceNumber}" Width="85" />
                        <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="85" />
                        <DataGridTextColumn Header="Επώνυμο" Binding="{Binding LastName}" Width="*" />
                        <DataGridTextColumn Header="Όνομα" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="Μονάδα/Λόχος" Binding="{Binding UnitName}" Width="110" />
                        <DataGridTextColumn Header="Διαφορές (Diff)" Binding="{Binding FullDiffSummary}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
