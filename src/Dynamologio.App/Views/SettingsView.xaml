<UserControl x:Class="Dynamologio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Ρυθμίσεις Συστήματος &amp; Συντήρηση Βάσης" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                <TextBlock Text="Διαμόρφωση στοιχείων μονάδας, λήψη και επαναφορά αντιγράφων ασφαλείας" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Deployment Unit Configuration -->
            <Border Grid.Row="1" Style="{StaticResource CardContainer}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Στοιχεία Εγκατάστασης &amp; Μονάδας" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ονομασία Μονάδας / Σχηματισμού *" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ονομασία Γραφείου / Τμήματος *" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding OfficeName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Αποθήκευση Στοιχείων Μονάδας" Command="{Binding SaveUnitSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Height="32" />
                </StackPanel>
            </Border>

            <!-- Backup & Restore -->
            <Border Grid.Row="2" Style="{StaticResource CardContainer}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Αντίγραφα Ασφαλείας &amp; Επαναφορά Δεδομένων" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Δημιουργήστε ένα κρυπτογραφικά υπογεγραμμένο ZIP αντίγραφο ασφαλείας (SHA-256) ή επαναφέρετε προηγούμενο αντίγραφο." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾 Δημιουργία Αντιγράφου Ασφαλείας" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,10,0" />
                        <Button Content="⚠️ Επαναφορά από Αντίγραφο" Command="{Binding RestoreBackupCommand}" Style="{StaticResource DangerButton}" Height="34" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Grid.Row="3" Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Τεχνικά Διαγνωστικά" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Εξαγωγή πακέτου τεχνικών διαγνωστικών για offline υποστήριξη και τεχνικό έλεγχο." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <Button Content="📦 Εξαγωγή Πακέτου Διαγνωστικών" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Height="34" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
