<UserControl x:Class="Dynamologio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Ρυθμίσεις" Style="{StaticResource TypePageTitle}" />
                <TextBlock Text="Διαμόρφωση στοιχείων μονάδας, διαχείριση κρυπτογραφημένων αντιγράφων και διαγνωστικά" Style="{StaticResource TypePageSubtitle}" />
            </StackPanel>

            <!-- 2. Deployment Unit Configuration -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Στοιχεία Εγκατάστασης &amp; Μονάδας" Style="{StaticResource TypeSectionTitle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ονομασία Μονάδας / Σχηματισμού *" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ονομασία Γραφείου / Τμήματος *" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding OfficeName, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Αποθήκευση Στοιχείων Μονάδας" Command="{Binding SaveUnitSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Height="34" Padding="14,0" />
                </StackPanel>
            </Border>

            <!-- 3. Backup & Restore -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Αντίγραφα Ασφαλείας &amp; Επαναφορά Δεδομένων" Style="{StaticResource TypeSectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="Δημιουργία κρυπτογραφημένου ZIP αντιγράφου ασφαλείας με έλεγχο ακεραιότητας SHA-256 / HMAC ή επαναφορά προηγούμενου αντιγράφου." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSaveGeometry}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Δημιουργία Αντιγράφου Ασφαλείας" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RestoreBackupCommand}" Style="{StaticResource DangerButton}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistoryGeometry}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Επαναφορά από Αντίγραφο" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Diagnostics -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Τεχνικά Διαγνωστικά" Style="{StaticResource TypeSectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="Εξαγωγή ανωνυμοποιημένου πακέτου τεχνικών διαγνωστικών για offline υποστήριξη και τεχνικό έλεγχο." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                    <Button Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Height="34" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettingsGeometry}" Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Εξαγωγή Πακέτου Διαγνωστικών" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
