<UserControl x:Class="Dynamologio.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ιστορικό Ενεργειών &amp; Καταγραφές Ελέγχου (Audit Trail)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                <TextBlock Text="Πλήρες χρονολόγιο καταχωρήσεων, ενημερώσεων, ακυρώσεων και εισαγωγών" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Ανανέωση" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="32" />
        </Grid>

        <!-- Audit Table & Filter -->
        <Border Grid.Row="1" Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search & Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedEntityType}" SelectedValuePath="Content" VerticalAlignment="Center">
                        <ComboBoxItem Content="Όλα" IsSelected="True" />
                        <ComboBoxItem Content="Personnel" />
                        <ComboBoxItem Content="StatusEvent" />
                        <ComboBoxItem Content="ServiceAssignment" />
                    </ComboBox>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredEventsList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ημερομηνία/Ώρα" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="140" />
                        <DataGridTextColumn Header="Χρήστης" Binding="{Binding Username}" Width="100" />
                        <DataGridTextColumn Header="Ενέργεια" Binding="{Binding Action}" Width="90" />
                        <DataGridTextColumn Header="Οντότητα" Binding="{Binding EntityType}" Width="110" />
                        <DataGridTextColumn Header="Σύνοψη Μεταβολής" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
