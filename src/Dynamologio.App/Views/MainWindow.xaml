<Window x:Class="Dynamologio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Dynamologio.App.ViewModels"
        xmlns:views="clr-namespace:Dynamologio.App.Views"
        Title="ΔΥΝΑΜΟΛΟΓΙΟ — Σταθμός Διαχείρισης Δύναμης &amp; Μεταβολών Προσωπικού"
        Height="820" Width="1280" MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DynamologioViewModel}">
            <views:DynamologioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersonnelViewModel}">
            <views:PersonnelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AbsencesViewModel}">
            <views:AbsencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataValidationViewModel}">
            <views:DataValidationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Modern Sidebar Navigation Item Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="GroupName" Value="SidebarNavGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="6,2" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Active Accent Bar -->
                                <Rectangle x:Name="activeBar" Grid.Column="0" Fill="{StaticResource NavActiveAccentBrush}" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" />

                                <!-- Icon & Label Content -->
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource SidebarItemHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="activeBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 1. Top Institutional Header -->
        <Border Grid.Row="0" Background="{StaticResource ShellDarkBrush}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand & Unit Context -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconAppLogoGeometry}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ΔΥΝΑΜΟΛΟΓΙΟ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0" />
                    <TextBlock Text="{Binding UnitNameHeader}" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <TextBlock Text="{Binding OfficeNameHeader}" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Security / Connection State -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Τοπικός Σταθμός" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Body: Compact Navigation Sidebar (180px) + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="160" MaxWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Graphite) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,8">
                        
                        <!-- Dashboard -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHomeGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Αρχική" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Dynamologio -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Dynamologio, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dynamologio">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStrengthGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Δυναμολόγιο" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Personnel -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Personnel, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Personnel">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPersonnelGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Προσωπικό" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Absences -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Absences, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Absences">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAbsenceGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Απουσίες" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Services -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Services, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Services">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconServiceGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Υπηρεσίες" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Reports -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Reports, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Reports">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrintGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Αναφορές" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Separator Line -->
                        <Border Height="1" Background="#1F2937" Margin="12,6,12,6" />

                        <!-- Import -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=ImportExport, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ImportExport">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImportGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Εισαγωγή" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Validation -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=DataValidation, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="DataValidation">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconValidationGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Έλεγχος" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- History -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=History, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="History">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistoryGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Ιστορικό" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Settings -->
                        <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettingsGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Ρυθμίσεις" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Working Canvas Container -->
            <Border Grid.Column="1" Background="{StaticResource CanvasBgBrush}">
                <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage, FallbackValue='Σύστημα έτοιμο. Βάση δεδομένων: LiteDB 5.x Ενσωματωμένη (DPAPI Encrypted).'}" 
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="ΔΥΝΑΜΟΛΟΓΙΟ v1.0.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
