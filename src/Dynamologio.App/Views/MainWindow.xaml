<Window x:Class="Dynamologio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Dynamologio.App.Views"
        xmlns:viewmodels="clr-namespace:Dynamologio.App.ViewModels"
        mc:Ignorable="d"
        Title="ΔΥΝΑΜΟΛΟΓΙΟ - Σύστημα Διαχείρισης Δυνάμεως Προσωπικού" 
        Height="768" Width="1280" MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DynamologioViewModel}">
            <views:DynamologioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PersonnelViewModel}">
            <views:PersonnelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AbsencesViewModel}">
            <views:AbsencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ServicesViewModel}">
            <views:ServicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource NavyDarkBrush}" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🇬🇷" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ΔΥΝΑΜΟΛΟΓΙΟ" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text=" | 1ο ΓΡΑΦΕΙΟ" FontWeight="SemiBold" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding CurrentDateDisplay}" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />

                <Button Grid.Column="3" Content="🔄 Ανανέωση" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshAllCommand}" VerticalAlignment="Center" Padding="12,5" FontSize="12" />
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <StackPanel Margin="0,10,0,0">
                    <!-- Nav Buttons -->
                    <Button Content="📊 Αρχική (Dashboard)" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="📋 Δυναμολόγιο" Command="{Binding NavigateCommand}" CommandParameter="Dynamologio" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="👥 Προσωπικό" Command="{Binding NavigateCommand}" CommandParameter="Personnel" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="📝 Απουσίες / Άδειες" Command="{Binding NavigateCommand}" CommandParameter="Absences" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="🛡️ Υπηρεσίες" Command="{Binding NavigateCommand}" CommandParameter="Services" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="📂 Εισαγωγή / Εξαγωγή" Command="{Binding NavigateCommand}" CommandParameter="ImportExport" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    <Button Content="⚙️ Ρυθμίσεις &amp; Αντίγραφα" Command="{Binding NavigateCommand}" CommandParameter="Settings" Height="44" HorizontalContentAlignment="Left" Padding="16,0" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="#475569" />
                <TextBlock Grid.Column="1" Text="🔒 100% Εκτός Δικτύου (Air-Gapped)" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Έκδοση 1.0.0 (.NET 4.7.2)" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" />
            </Grid>
        </Border>
    </Grid>
</Window>
