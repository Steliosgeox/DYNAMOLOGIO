<Window x:Class="Dynamologio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Dynamologio.App.ViewModels"
        xmlns:views="clr-namespace:Dynamologio.App.Views"
        Title="ΔΥΝΑΜΟΛΟΓΙΟ — Σταθμός Διαχείρισης Δύναμης &amp; Μεταβολών Προσωπικού"
        Height="820" Width="1280" MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DynamologioViewModel}">
            <views:DynamologioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersonnelViewModel}">
            <views:PersonnelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AbsencesViewModel}">
            <views:AbsencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataValidationViewModel}">
            <views:DataValidationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Navigation RadioButton Style with Visible Cyan Active Indicator Strip -->
        <Style x:Key="SidebarNavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="GroupName" Value="SidebarNavGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Active 4px Cyan Indicator Strip -->
                                <Rectangle x:Name="activeIndicator" Grid.Column="0" Fill="#38BDF8" Width="4" Height="26" RadiusX="2" RadiusY="2" Visibility="Collapsed" />

                                <!-- Content -->
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Top Header Chrome -->
        <Border Grid.Row="0" Background="{StaticResource HeaderDarkBrush}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand & Unit Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconAppLogoGeometry}" Fill="{StaticResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ΔΥΝΑΜΟΛΟΓΙΟ" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text=" | " FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <TextBlock Text="{Binding UnitNameHeader}" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0" />
                    <TextBlock Text="{Binding OfficeNameHeader}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Offline Tag -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Τοπικός Σταθμός (Air-Gapped)" FontSize="11" Foreground="#94A3B8" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Slate Navy) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,10">
                        
                        <!-- Dashboard Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHomeGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Αρχική" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Dynamologio Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Dynamologio, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dynamologio">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStrengthGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Δυναμολόγιο" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Personnel Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Personnel, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Personnel">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPersonnelGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Προσωπικό" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Absences Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Absences, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Absences">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAbsenceGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Απουσίες &amp; Άδειες" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Services Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Services, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Services">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconServiceGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Υπηρεσίες" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Reports Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Reports, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Reports">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrintGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Αναφορές &amp; Εξαγωγές" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Background="#334155" Margin="14,10" Height="1" />

                        <!-- Import Excel Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=ImportExport, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ImportExport">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImportGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Εισαγωγή Excel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Data Validation Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=DataValidation, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="DataValidation">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconValidationGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Έλεγχος Δεδομένων" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- History Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=History, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="History">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistoryGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Ιστορικό (Audit)" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Settings Nav Item -->
                        <RadioButton Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBoolConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettingsGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Ρυθμίσεις &amp; Backup" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Dynamic Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Σύστημα έτοιμο. Βάση δεδομένων: LiteDB 5.x Ενσωματωμένη (DPAPI Encrypted)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="ΔΥΝΑΜΟΛΟΓΙΟ v1.0.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
