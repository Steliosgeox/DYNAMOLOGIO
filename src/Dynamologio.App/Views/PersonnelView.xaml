<UserControl x:Class="Dynamologio.App.Views.PersonnelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Προσωπικό" Style="{StaticResource TypePageTitle}" />
                <TextBlock Text="Μητρώο στελεχών, οπλιτών, στοιχεία τοποθέτησης και ιστορικό υπηρεσιών/αδειών" Style="{StaticResource TypePageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Προσθήκη Προσωπικού" Command="{Binding AddPersonCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" />
            </StackPanel>
        </Grid>

        <!-- 2. Main Master/Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="340" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- Left: Personnel List & Search -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search & Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="34" />
                        <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedCategoryFilter}" SelectedValuePath="Content" VerticalAlignment="Center" Height="34">
                            <ComboBoxItem Content="Όλοι" IsSelected="True" />
                            <ComboBoxItem Content="Στελέχη" />
                            <ComboBoxItem Content="Οπλίτες" />
                        </ComboBox>
                    </Grid>

                    <!-- Table with Modern Light Neutral Header -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayPersonnel}" SelectedItem="{Binding SelectedPerson}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="75" />
                            <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding FullName}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="ΑΣΜ" Binding="{Binding Asm}" Width="85" />
                            <DataGridTextColumn Header="Μονάδα / Λόχος" Binding="{Binding UnitName}" Width="120" />
                            <DataGridTextColumn Header="Κατάσταση" Binding="{Binding StatusDisplayLabel}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Detail Panel for Selected Person -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Καρτέλα Προσωπικού" Style="{StaticResource TypeSectionTitle}" Margin="0,0,0,12" />

                        <!-- Identity Card -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPerson.FullName, FallbackValue='Επιλέξτε πρόσωπο από τη λίστα'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedPerson.RankName}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ΑΣΜ" Style="{StaticResource TypeCaption}" />
                                        <TextBlock Text="{Binding SelectedPerson.Asm, FallbackValue='-'}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Μονάδα / Λόχος" Style="{StaticResource TypeCaption}" />
                                        <TextBlock Text="{Binding SelectedPerson.UnitName, FallbackValue='-'}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Actions for Selected Person -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Επεξεργασία" Command="{Binding EditPersonCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0" />
                            <Button Content="Αρχειοθέτηση" Command="{Binding ArchivePersonCommand}" Style="{StaticResource DangerButton}" Height="32" Padding="12,0" />
                        </StackPanel>

                        <!-- Absence History -->
                        <TextBlock Text="Ιστορικό Μεταβολών &amp; Αδειών" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding SelectedPersonAbsenceHistory}" Height="120" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Από" Binding="{Binding StartAt, StringFormat='dd/MM/yy'}" Width="65" />
                                <DataGridTextColumn Header="Έως" Binding="{Binding EndAtExclusive, StringFormat='dd/MM/yy'}" Width="65" />
                                <DataGridTextColumn Header="Διαταγή" Binding="{Binding ReferenceDocument}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Service History -->
                        <TextBlock Text="Ιστορικό Υπηρεσιών" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding SelectedPersonServiceHistory}" Height="110">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ημ/νία" Binding="{Binding ServiceDate, StringFormat='dd/MM/yy'}" Width="65" />
                                <DataGridTextColumn Header="Ώρες" Binding="{Binding StartDateTime, StringFormat='HH:mm'}" Width="55" />
                                <DataGridTextColumn Header="Τοποθεσία" Binding="{Binding DutyLocation}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
