<UserControl x:Class="Dynamologio.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Κέντρο Επίσημων Αναφορών &amp; Εξαγωγών" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                <TextBlock Text="Παραγωγή επίσημων εγγράφων δύναμης, ονομαστικών καταστάσεων και προγραμμάτων υπηρεσίας" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconImportGeometry}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Εξαγωγή Excel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PrintReportCommand}" Style="{StaticResource SecondaryButton}" Height="34">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPrintGeometry}" Fill="{StaticResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Εκτύπωση" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300" MaxWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Report Type & Scope Parameters -->
            <Border Grid.Column="0" Style="{StaticResource CardContainer}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Επιλογή Αναφοράς &amp; Παραμέτρων" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,12" />

                        <!-- Report Catalog List -->
                        <TextBlock Text="Τύπος Αναφοράς *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding AvailableReports}" SelectedItem="{Binding SelectedReport}" Height="150" Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Date -->
                        <TextBlock Text="Ημερομηνία Αναφοράς *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,0,0,12" />

                        <!-- Scope -->
                        <TextBlock Text="Μονάδα / Λόχος" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding UnitsList}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name" Margin="0,0,0,16" />

                        <Button Content="Ανανέωση Προεπισκόπησης" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource SecondaryButton}" Height="32" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Preview Surface -->
            <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SelectedReport.Title, FallbackValue='Προεπισκόπηση Αναφοράς'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                    <!-- Tabbed Preview Content -->
                    <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent">
                        <TabItem Header="Σύνοψη Δύναμης">
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Συνολική Δύναμη:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewSnapshot.TotalActiveStrength}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Παρόντες:" FontSize="11" Foreground="{StaticResource PresentBrush}" />
                                            <TextBlock Text="{Binding PreviewSnapshot.TotalPresent}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PresentBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Απόντες:" FontSize="11" Foreground="{StaticResource AbsentBrush}" />
                                            <TextBlock Text="{Binding PreviewSnapshot.TotalAbsent}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AbsentBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Κατανομή Ανά Κατηγορία:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding PreviewSnapshot.OfficersAndNcosActive, StringFormat='• Στελέχη: {0}'}" />
                                    <TextBlock Text="{Binding PreviewSnapshot.ConscriptsActive, StringFormat='• Οπλίτες: {0}'}" />
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="Απόντες">
                            <Grid Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding PreviewSnapshot.AbsentPersonnel}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Βαθμός" Binding="{Binding Rank.ShortName}" Width="80" />
                                        <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding Person.FullName}" Width="*" />
                                        <DataGridTextColumn Header="Αιτιολογία" Binding="{Binding ActiveStatusType.Name}" Width="120" />
                                        <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplayLabel}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Παρόντες">
                            <Grid Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding PreviewSnapshot.PresentPersonnel}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Βαθμός" Binding="{Binding Rank.ShortName}" Width="80" />
                                        <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding Person.FullName}" Width="*" />
                                        <DataGridTextColumn Header="Μονάδα/Λόχος" Binding="{Binding Unit.Name}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
