<UserControl x:Class="Dynamologio.App.Views.AbsencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Dynamologio.App.Controls"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Page Header Component -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Απουσίες" Style="{StaticResource TypePageTitle}" />
                <TextBlock Text="Καταχώρηση, παρακολούθηση και διαχείριση αδειών, αναρρωτικών και αποσπάσεων" Style="{StaticResource TypePageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Primary Action: New Absence -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenCreateDrawerCommand}" Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlusGeometry}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Νέα Απουσία" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main Workspace: Full-Width Roster + Dynamic Slide-Over Drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Full-Width Absence Roster Card -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,0">
                <TabControl>
                    <!-- 1. Active Absences Tab -->
                    <TabItem Header="Ενεργές Σήμερα">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding ActiveEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός &amp; Ονοματεπώνυμο" Binding="{Binding PersonFullName}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="Μονάδα / Λόχος" Binding="{Binding UnitName}" Width="130" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding ReasonName}" Width="140" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή / Έγκριση" Binding="{Binding ReferenceDoc}" Width="130" />
                                    <DataGridTemplateColumn Header="Ενέργειες" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ακύρωση" Style="{StaticResource DangerButton}" Height="26" Padding="6,0" FontSize="11"
                                                        Command="{Binding DataContext.CancelAbsenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Quiet Empty State Overlay -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16"
                                    Visibility="{Binding ActiveEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconCheckGeometry}" Fill="{StaticResource PresentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                    <TextBlock Text="Δεν υπάρχουν ενεργές απουσίες για σήμερα." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 2. Planned Absences Tab -->
                    <TabItem Header="Προγραμματισμένες">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding PlannedEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός &amp; Ονοματεπώνυμο" Binding="{Binding PersonFullName}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="Μονάδα / Λόχος" Binding="{Binding UnitName}" Width="130" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding ReasonName}" Width="140" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή / Έγκριση" Binding="{Binding ReferenceDoc}" Width="130" />
                                    <DataGridTemplateColumn Header="Ενέργειες" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ακύρωση" Style="{StaticResource DangerButton}" Height="26" Padding="6,0" FontSize="11"
                                                        Command="{Binding DataContext.CancelAbsenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Quiet Empty State Overlay -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16"
                                    Visibility="{Binding PlannedEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Δεν υπάρχουν προγραμματισμένες μελλοντικές απουσίες." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 3. Past / History Absences Tab -->
                    <TabItem Header="Ιστορικό Απουσιών">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding PastEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός &amp; Ονοματεπώνυμο" Binding="{Binding PersonFullName}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="Μονάδα / Λόχος" Binding="{Binding UnitName}" Width="130" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding ReasonName}" Width="140" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή / Έγκριση" Binding="{Binding ReferenceDoc}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Quiet Empty State Overlay -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16"
                                    Visibility="{Binding PastEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Δεν υπάρχουν ιστορικές καταχωρήσεις απουσιών." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Slide-Over New Absence Drawer Panel (Visible only when IsCreateDrawerOpen is true) -->
            <Border Grid.Column="1" Width="360" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0" Margin="14,0,0,0"
                    Visibility="{Binding IsCreateDrawerOpen, Converter={StaticResource BoolToVisConverter}}">
                <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Drawer Header with Close Button -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Καταχώρηση Νέας Απουσίας" Style="{StaticResource TypeSectionTitle}" VerticalAlignment="Center" />
                                <Button Command="{Binding CloseCreateDrawerCommand}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Person Selector (5D Searchable) -->
                            <TextBlock Text="Στέλεχος / Οπλίτης *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ctrl:SearchablePersonPicker ItemsSource="{Binding SearchablePersonnelList}" SelectedItem="{Binding SelectedPerson}" Margin="0,0,0,10" />

                            <!-- Absence Type -->
                            <TextBlock Text="Είδος Απουσίας / Άδειας *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding StatusTypesList}" SelectedItem="{Binding SelectedStatusType}" DisplayMemberPath="Name" Margin="0,0,0,10" />

                            <!-- Dates -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Έναρξη *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding StartDate}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Επιστροφή *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ReturnDate}" />
                                </StackPanel>
                            </Grid>

                            <!-- Computed Summary Feedback Box -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding ComputedSummaryText}" FontSize="11.5" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Reference Document -->
                            <TextBlock Text="Αριθμός Διαταγής / Έγκρισης" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReferenceDoc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <!-- Notes -->
                            <TextBlock Text="Αιτιολογία / Παρατηρήσεις" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                            <!-- Error Message -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                                    Visibility="{Binding InlineErrorMessage, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="{Binding InlineErrorMessage}" Foreground="#DC2626" FontSize="11.5" TextWrapping="Wrap" />
                            </Border>

                            <!-- Save / Cancel Action Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveAbsenceCommand}" Style="{StaticResource PrimaryButton}" Content="Αποθήκευση" Height="36" />
                                <Button Grid.Column="2" Command="{Binding CloseCreateDrawerCommand}" Style="{StaticResource SecondaryButton}" Content="Ακύρωση" Height="36" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
