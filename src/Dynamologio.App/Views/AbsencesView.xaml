<UserControl x:Class="Dynamologio.App.Views.AbsencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Dynamologio.App.Controls"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Διαχείριση Απουσιών &amp; Αδειών" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                <TextBlock Text="Καταχώρηση αδειών, αναρρωτικών, αποσπάσεων και αυτόματος υπολογισμός ημερομηνιών επιστροφής" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Body: Entry Form + Segmented Lists -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Absence Registration Form Card -->
            <Border Grid.Column="0" Style="{StaticResource CardContainer}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Καταχώρηση Νέας Απουσίας" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,12" />

                        <!-- Searchable Person Picker -->
                        <TextBlock Text="Στέλεχος / Οπλίτης *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ctrl:SearchablePersonPicker ItemsSource="{Binding PersonnelList}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}" Margin="0,0,0,10" />

                        <!-- Status Type -->
                        <TextBlock Text="Είδος Απουσίας / Άδειας *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding StatusTypesList}" SelectedItem="{Binding SelectedStatusType}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,10" />

                        <!-- Dates -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Έναρξη *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding StartDate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Επιστροφή *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding ReturnDate}" />
                            </StackPanel>
                        </Grid>

                        <!-- Live Calculation Summary Pill -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ComputedSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Reference Document -->
                        <TextBlock Text="Αριθμός Διαταγής / Έγκρισης" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ReferenceDoc, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10" />

                        <!-- Comments -->
                        <TextBlock Text="Αιτιολογία / Παρατηρήσεις" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Feedback Messages -->
                        <TextBlock Text="{Binding InlineErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding InlineErrorMessage, Converter={StaticResource StringToVisConverter}}" />
                        <TextBlock Text="{Binding InlineSuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding InlineSuccessMessage, Converter={StaticResource StringToVisConverter}}" />

                        <Button Content="Καταχώρηση Απουσίας" Command="{Binding SaveAbsenceCommand}" Style="{StaticResource PrimaryButton}" Height="36" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Segmented Tab Lists (Active | Planned | History) -->
            <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                <TabControl>
                    <!-- Active Absences Today -->
                    <TabItem Header="Ενεργές Σήμερα">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding ActiveEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="80" />
                                    <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding PersonName}" Width="*" />
                                    <DataGridTextColumn Header="Υπομονάδα" Binding="{Binding UnitName}" Width="110" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding StatusTypeName}" Width="130" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartAt, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding EndAtExclusive, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή" Binding="{Binding ReferenceDoc}" Width="110" />
                                    <DataGridTemplateColumn Header="Ενέργεια" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ακύρωση" Command="{Binding DataContext.CancelAbsenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Foreground="{StaticResource DangerBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border Style="{StaticResource EmptyStateCard}" Visibility="{Binding ActiveEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconAbsenceGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Δεν υπάρχουν ενεργές απουσίες για σήμερα." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Όλο το καταγεγραμμένο προσωπικό βρίσκεται εντός μονάδας." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Planned Future Absences -->
                    <TabItem Header="Προγραμματισμένες">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding PlannedEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="80" />
                                    <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding PersonName}" Width="*" />
                                    <DataGridTextColumn Header="Υπομονάδα" Binding="{Binding UnitName}" Width="110" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding StatusTypeName}" Width="130" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartAt, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding EndAtExclusive, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή" Binding="{Binding ReferenceDoc}" Width="110" />
                                    <DataGridTemplateColumn Header="Ενέργεια" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ακύρωση" Command="{Binding DataContext.CancelAbsenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Foreground="{StaticResource DangerBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border Style="{StaticResource EmptyStateCard}" Visibility="{Binding PlannedEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconAbsenceGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Δεν υπάρχουν μελλοντικές προγραμματισμένες απουσίες." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Past Absences History -->
                    <TabItem Header="Ιστορικό">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding PastEventsList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="80" />
                                    <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding PersonName}" Width="*" />
                                    <DataGridTextColumn Header="Υπομονάδα" Binding="{Binding UnitName}" Width="110" />
                                    <DataGridTextColumn Header="Είδος Απουσίας" Binding="{Binding StatusTypeName}" Width="130" />
                                    <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartAt, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Επιστροφή" Binding="{Binding EndAtExclusive, StringFormat='dd/MM/yyyy'}" Width="95" />
                                    <DataGridTextColumn Header="Διαταγή" Binding="{Binding ReferenceDoc}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border Style="{StaticResource EmptyStateCard}" Visibility="{Binding PastEventsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconHistoryGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Δεν υπάρχει προηγούμενο ιστορικό απουσιών." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
