<UserControl x:Class="Dynamologio.App.Views.AbsencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: New Absence Form -->
        <Border Grid.Column="0" Style="{StaticResource CardContainer}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📝 Καταχώρηση Νέας Απουσίας / Άδειας" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,16" />

                    <!-- Person Selector -->
                    <TextBlock Text="Στέλεχος / Οπλίτης:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding PersonnelList}" SelectedItem="{Binding SelectedPerson}" DisplayMemberPath="FullName" Margin="0,0,0,12" />

                    <!-- Absence Type -->
                    <TextBlock Text="Είδος Απουσίας:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding StatusTypesList}" SelectedItem="{Binding SelectedStatusType}" DisplayMemberPath="Name" Margin="0,0,0,12" />

                    <!-- Start Date -->
                    <TextBlock Text="Ημερομηνία Έναρξης (Από):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,12" />

                    <!-- Return Date -->
                    <TextBlock Text="Ημερομηνία Επιστροφής (Έως/Επιστροφή):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ReturnDate}" Margin="0,0,0,12" />

                    <!-- Reference Order -->
                    <TextBlock Text="Αριθμός Διαταγής / Έγκριση:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ReferenceDoc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Comment -->
                    <TextBlock Text="Παρατηρήσεις / Αιτιολογία:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                    <!-- Save Button -->
                    <Button Content="💾 Αποθήκευση Μεταβολής" Style="{StaticResource SuccessButton}" Command="{Binding SaveAbsenceCommand}" Height="36" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Active Absences List -->
        <Border Grid.Column="1" Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 Ιστορικό &amp; Ενεργές Μεταβολές" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveEventsList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Έναρξη" Binding="{Binding StartAt, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" />
                        <DataGridTextColumn Header="Επιστροφή" Binding="{Binding EndAtExclusive, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" />
                        <DataGridTextColumn Header="Διαταγή" Binding="{Binding ReferenceDocument}" Width="160" />
                        <DataGridTextColumn Header="Παρατηρήσεις" Binding="{Binding Comment}" Width="*" />
                        <DataGridTemplateColumn Header="Ενέργεια" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ακύρωση" Style="{StaticResource DangerButton}" Padding="6,2" FontSize="11"
                                            Command="{Binding DataContext.CancelAbsenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
