<UserControl x:Class="Dynamologio.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Επιχειρησιακή Επισκόπηση (Αρχική)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
            <TextBlock Text="Συγκεντρωτική εικόνα πραγματικής δύναμης μονάδας και ενεργών μεταβολών" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Integrated Compact Strength Strip -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active Total -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="ΥΠΑΡΧΟΥΣΑ ΔΥΝΑΜΗ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalActive}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource BorderSubtleBrush}" />

                <!-- Present -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="ΠΑΡΟΝΤΕΣ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PresentBrush}" />
                    <TextBlock Text="{Binding TotalPresent}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PresentBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{StaticResource BorderSubtleBrush}" />

                <!-- Absent -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="ΑΠΟΝΤΕΣ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AbsentBrush}" />
                    <TextBlock Text="{Binding TotalAbsent}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AbsentBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{StaticResource BorderSubtleBrush}" />

                <!-- Returning Today -->
                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                    <TextBlock Text="ΕΠΙΣΤΡΟΦΕΣ ΣΗΜΕΡΑ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ReturningToday}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="7" Fill="{StaticResource BorderSubtleBrush}" />

                <!-- Returning Tomorrow -->
                <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                    <TextBlock Text="ΕΠΙΣΤΡΟΦΕΣ ΑΥΡΙΟ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ReturningTomorrow}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Operational Grid: Today's Absences & Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Absentees Table -->
            <Border Grid.Column="0" Style="{StaticResource CardContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ονομαστική Κατάσταση Απόντων Σήμερα" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AbsentPersonnelList}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Βαθμός" Binding="{Binding Rank.ShortName}" Width="80" />
                            <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding Person.FullName}" Width="*" />
                            <DataGridTextColumn Header="Μονάδα/Λόχος" Binding="{Binding Unit.Name}" Width="120" />
                            <DataGridTextColumn Header="Αιτιολογία" Binding="{Binding ActiveStatusType.Name}" Width="110" />
                            <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplayLabel}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Quick Action Shortcuts Panel -->
            <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Άμεσες Ενέργειες" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,0,12" />

                    <Button Content="📊 Προβολή Δυναμολογίου" Command="{Binding NavigateToDynamologioCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" />
                    <Button Content="📝 Καταχώρηση Μεταβολής" Command="{Binding NavigateToAbsencesCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" />
                    <Button Content="👥 Μητρώο Προσωπικού" Command="{Binding NavigateToPersonnelCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" />
                    <Button Content="🛡️ Ημερήσιες Υπηρεσίες" Command="{Binding NavigateToServicesCommand}" Style="{StaticResource SecondaryButton}" Height="36" HorizontalContentAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
