<UserControl x:Class="Dynamologio.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Metric KPI Cards Row -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Strength -->
            <Border Grid.Column="0" Style="{StaticResource CardContainer}" Margin="0,0,10,0" Background="#1E293B">
                <StackPanel>
                    <TextBlock Text="ΣΥΝΟΛΙΚΗ ΔΥΝΑΜΗ" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding TotalActive}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Ενεργό Προσωπικό" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Present -->
            <Border Grid.Column="1" Style="{StaticResource CardContainer}" Margin="5,0,5,0" BorderBrush="#059669" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="ΠΑΡΟΝΤΕΣ" Foreground="#059669" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding TotalPresent}" Foreground="#059669" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Εντός Μονάδας" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Absent -->
            <Border Grid.Column="2" Style="{StaticResource CardContainer}" Margin="5,0,5,0" BorderBrush="#DC2626" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="ΑΠΟΝΤΕΣ" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding TotalAbsent}" Foreground="#DC2626" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Άδειες / Νοσηλείες / ΦΠ" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Officers & Conscripts -->
            <Border Grid.Column="3" Style="{StaticResource CardContainer}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="ΚΑΤΑΝΟΜΗ" Foreground="#475569" FontWeight="Bold" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Στελέχη: " Foreground="#64748B" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OfficersActive}" FontWeight="Bold" Foreground="#1E293B" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Οπλίτες: " Foreground="#64748B" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConscriptsActive}" FontWeight="Bold" Foreground="#1E293B" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Returns Today / Tomorrow -->
            <Border Grid.Column="4" Style="{StaticResource CardContainer}" Margin="10,0,0,0" Background="#EFF6FF" BorderBrush="#93C5FD">
                <StackPanel>
                    <TextBlock Text="ΕΠΙΣΤΡΟΦΕΣ" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Σήμερα: " Foreground="#1E40AF" />
                        <TextBlock Text="{Binding ReturningToday}" FontWeight="Bold" Foreground="#1D4ED8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Αύριο: " Foreground="#1E40AF" />
                        <TextBlock Text="{Binding ReturningTomorrow}" FontWeight="Bold" Foreground="#1D4ED8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick Actions Row -->
        <Border Grid.Row="1" Style="{StaticResource CardContainer}" Margin="0,0,0,20" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Γρήγορες Ενέργειες:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0" Foreground="#334155" />
                <Button Content="📊 Προβολή Δυναμολογίου" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateToDynamologioCommand}" Margin="0,0,8,0" />
                <Button Content="📝 Νέα Απουσία / Μεταβολή" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateToAbsencesCommand}" Margin="0,0,8,0" />
                <Button Content="🛡️ Ανάθεση Υπηρεσίας" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateToServicesCommand}" Margin="0,0,8,0" />
                <Button Content="👤 Διαχείριση Προσωπικού" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateToPersonnelCommand}" />
            </StackPanel>
        </Border>

        <!-- Current Absent Nominal Table -->
        <Border Grid.Row="2" Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Τρέχοντες Απόντες από τη Μονάδα (Αυτόματος Υπολογισμός)" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="#1E293B" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding AbsentPersonnelList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Βαθμός" Binding="{Binding Rank.ShortName}" Width="100" />
                        <DataGridTextColumn Header="Επώνυμο" Binding="{Binding Person.LastName}" Width="160" />
                        <DataGridTextColumn Header="Όνομα" Binding="{Binding Person.FirstName}" Width="140" />
                        <DataGridTextColumn Header="Μονάδα / Λόχος" Binding="{Binding Unit.Name}" Width="130" />
                        <DataGridTextColumn Header="Αιτιολογία Απουσίας" Binding="{Binding ActiveStatusType.Name}" Width="180" />
                        <DataGridTextColumn Header="Από" Binding="{Binding ActiveStatusEvent.StartAt, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" />
                        <DataGridTextColumn Header="Επιστροφή" Binding="{Binding ReturnDisplayLabel}" Width="110" />
                        <DataGridTextColumn Header="Διαταγή / Έγγραφο" Binding="{Binding ActiveStatusEvent.ReferenceDocument}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
