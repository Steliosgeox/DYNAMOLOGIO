<UserControl x:Class="Dynamologio.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Dynamologio.App.Controls"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Υπηρεσίες" Style="{StaticResource TypePageTitle}" />
                <TextBlock Text="Προγραμματισμός ημερήσιων υπηρεσιών, βαρδιών και αναθέσεων σκοπών" Style="{StaticResource TypePageSubtitle}" />
            </StackPanel>

            <!-- Date Selector -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ημερομηνία:" Style="{StaticResource TypeSectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="135" Height="34" Margin="0,0,6,0" />
                <Button Content="Σήμερα" Command="{Binding SetTodayCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" Margin="0,0,4,0" />
                <Button Content="Αύριο" Command="{Binding SetTomorrowCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" />
            </StackPanel>
        </Grid>

        <!-- 2. Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300" MaxWidth="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Assignment Form Card -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Νέα Ανάθεση Υπηρεσίας" Style="{StaticResource TypeSectionTitle}" Margin="0,0,0,12" />

                        <!-- Person Selector -->
                        <TextBlock Text="Στέλεχος / Οπλίτης *" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                        <ctrl:SearchablePersonPicker ItemsSource="{Binding PersonnelList}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}" Margin="0,0,0,10" />

                        <!-- Service Type -->
                        <TextBlock Text="Είδος Υπηρεσίας *" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ServiceTypesList}" SelectedItem="{Binding SelectedServiceType}" DisplayMemberPath="Name" Height="34" Margin="0,0,0,10" />

                        <!-- Time Hours -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ώρα Έναρξης" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding StartTimeText}" Height="34" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ώρα Λήξης" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EndTimeText}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <!-- Location -->
                        <TextBlock Text="Τοποθεσία / Σημείο" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Location}" Height="34" Margin="0,0,0,10" />

                        <!-- Notes -->
                        <TextBlock Text="Παρατηρήσεις" Style="{StaticResource TypeCaption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Feedback Message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}" />

                        <Button Content="Καταχώρηση Υπηρεσίας" Command="{Binding AssignServiceCommand}" Style="{StaticResource PrimaryButton}" Height="36" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Services Roster Table with Empty State -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Πρόγραμμα Υπηρεσιών Επιλεγμένης Ημέρας" Style="{StaticResource TypeSectionTitle}" />
                        <TextBlock Text="{Binding DailyAssignmentsList.Count, StringFormat='({0} αναθέσεις)'}" Style="{StaticResource TypeCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Roster DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailyAssignmentsList}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Βαθμός" Binding="{Binding RankName}" Width="80" />
                            <DataGridTextColumn Header="Ονοματεπώνυμο" Binding="{Binding PersonName}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Είδος Υπηρεσίας" Binding="{Binding ServiceName}" Width="150" />
                            <DataGridTextColumn Header="Ώρες" Binding="{Binding HoursDisplay}" Width="100" />
                            <DataGridTextColumn Header="Τοποθεσία" Binding="{Binding Location}" Width="110" />
                            <DataGridTemplateColumn Header="Ενέργειες" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ακύρωση" Command="{Binding DataContext.CancelAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="26" Padding="6,0" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State Overlay -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18"
                            Visibility="{Binding DailyAssignmentsList.Count, Converter={StaticResource InvertedCountToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconCheckGeometry}" Fill="{StaticResource PresentBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                            <TextBlock Text="Δεν έχουν καταχωρηθεί υπηρεσίες για την επιλεγμένη ημερομηνία." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
