<UserControl x:Class="Dynamologio.App.Views.DataValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Έλεγχος Δεδομένων" Style="{StaticResource TypePageTitle}" />
                <TextBlock Text="Αυτόματος έλεγχος συνέπειας βάσης, ανίχνευση επικαλύψεων και επαλήθευση εγγραφών" Style="{StaticResource TypePageSubtitle}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Σάρωση Δεδομένων" Command="{Binding ScanDataCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" VerticalAlignment="Center" />
        </Grid>

        <!-- 2. Issues Grid -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Εντοπισμένα Ζητήματα" Style="{StaticResource TypeSectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="#FEE2E2" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalErrors, StringFormat='Σφάλματα: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding TotalWarnings, StringFormat='Προειδοποιήσεις: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#92400E" />
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Σοβαρότητα" Binding="{Binding SeverityLabel}" Width="110" />
                        <DataGridTextColumn Header="Κατηγορία" Binding="{Binding EntityCategory}" Width="120" />
                        <DataGridTextColumn Header="Στοιχείο" Binding="{Binding EntityName}" Width="180" />
                        <DataGridTextColumn Header="Περιγραφή Προβλήματος" Binding="{Binding Description}" Width="2*" MinWidth="200" />
                        <DataGridTextColumn Header="Προτεινόμενη Ενέργεια" Binding="{Binding ActionRecommendation}" Width="1.5*" MinWidth="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
