<UserControl x:Class="Dynamologio.App.Views.DataValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Κέντρο Ελέγχου &amp; Επαλήθευσης Δεδομένων" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeaderDarkBrush}" />
                <TextBlock Text="Αυτόματος έλεγχος συνέπειας βάσης, διπλοεγγραφών, ορφανών κωδικών και επικαλύψεων αδειών" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Σάρωση Δεδομένων" Command="{Binding ScanDataCommand}" Style="{StaticResource PrimaryButton}" Height="34" />
        </Grid>

        <!-- Issues Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Εντοπισμένα Ζητήματα" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="#FEE2E2" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalErrors, StringFormat='Σφάλματα: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding TotalWarnings, StringFormat='Προειδοποιήσεις: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Σοβαρότητα" Binding="{Binding SeverityLabel}" Width="110" />
                        <DataGridTextColumn Header="Κατηγορία" Binding="{Binding EntityCategory}" Width="100" />
                        <DataGridTextColumn Header="Στοιχείο" Binding="{Binding EntityName}" Width="180" />
                        <DataGridTextColumn Header="Περιγραφή Προβλήματος" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Προτεινόμενη Ενέργεια" Binding="{Binding ActionRecommendation}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
