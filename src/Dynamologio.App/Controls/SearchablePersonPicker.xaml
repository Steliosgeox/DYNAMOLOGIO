<UserControl x:Class="Dynamologio.App.Controls.SearchablePersonPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <!-- Main Input Display Box -->
        <Border x:Name="DisplayBorder" Background="#FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Height="34" Padding="8,2" Cursor="Hand" MouseLeftButtonDown="DisplayBorder_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource IconPersonnelGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="2,0,8,0" VerticalAlignment="Center" />

                <TextBlock x:Name="SelectedTextDisplay" Grid.Column="1" Text="Επιλέξτε Στέλεχος / Οπλίτη..." VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                <Path Grid.Column="2" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondaryBrush}" Margin="6,0,4,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Dropdown Popup with Live Filter Search -->
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=DisplayBorder}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="True">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Width="{Binding ActualWidth, ElementName=DisplayBorder}" MaxHeight="300" Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" />
                </Border.Effect>
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Filter Box -->
                    <TextBox x:Name="FilterTextBox" Grid.Row="0" Margin="0,0,0,6" TextChanged="FilterTextBox_TextChanged" KeyDown="FilterTextBox_KeyDown" />

                    <!-- Filtered ListBox -->
                    <ListBox x:Name="PersonnelListBox" Grid.Row="1" MaxHeight="220" BorderThickness="0" SelectionChanged="PersonnelListBox_SelectionChanged" KeyDown="PersonnelListBox_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayRank}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding DisplayFullName}" FontWeight="SemiBold" Foreground="{StaticResource HeaderDarkBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding DisplayUnit}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayAsm}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
